Bootstrap: docker
From: condaforge/miniforge3:latest

%post
    set -eux

    mamba create -y -n qc \
        -c bioconda -c conda-forge \
        python=3.11 \
        merqury \
        meryl \
        seqkit \
        samtools \
        bedtools \
        liftoff \
        gffread \
        minimap2 \
        winnowmap \
        syri \
        plotsr \
        biopython \
        'pandas<2' \
        matplotlib \
        pysam \
        mcscanx \
        diamond \
        blast \
        pycirclize \
        kakscalculator2 \
        orthofinder

    mamba clean --all --yes

%environment
    export PATH=/opt/conda/envs/qc/bin:$PATH
    export MERQURY=/opt/conda/envs/qc/share/merqury
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec "$@"