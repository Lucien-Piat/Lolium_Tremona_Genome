Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    Author Lucien Piat
    Purpose PurgeGrass dependencies, includes MCScanX built from source

%post
    # Make conda binaries visible during build (the %environment block is runtime only)
    export PATH=/opt/conda/bin:$PATH
    export MAMBA_ROOT_PREFIX=/opt/conda

    # Standard tools via conda
    micromamba install -y -n base -c bioconda -c conda-forge \
            python=3.10 \
            purge_haplotigs=1.1.3 \
            gmap=2024.11.20 \
            busco=5.8.2 \
            seqkit=2.8.2 \
            minimap2=2.28 \
            samtools=1.21 \
            bedtools=2.31 \
            gffread=0.12.7 \
            bcftools=1.21 \
            diamond=2.1.9 \
            mummer4=4.0.0 \
            r-base=4.3 \
            r-tidyverse \
            r-data.table \
            r-optparse \
            pigz \
            wget \
            unzip \
            perl \
            procps-ng \
            gxx \
            make

    # MCScanX is not on conda, build from source
    mkdir -p /opt/build && cd /opt/build
    wget -q https://github.com/wyp1125/MCScanX/archive/refs/heads/master.tar.gz
    tar xzf master.tar.gz
    cd MCScanX-master
    # Known compile issue with newer gcc, missing string.h includes
    sed -i '1i #include <string.h>' msa.h
    sed -i '1i #include <string.h>' dissect_multiple_alignment.h
    sed -i '1i #include <string.h>' detect_collinear_tandem_arrays.h
    make
    cp -r /opt/build/MCScanX-master /opt/MCScanX
    chmod +x /opt/MCScanX/MCScanX /opt/MCScanX/duplicate_gene_classifier
    cd / && rm -rf /opt/build

    micromamba clean --all --yes
    rm -rf /opt/conda/pkgs/cache/* 2>/dev/null || true

%environment
    export PATH=/opt/conda/bin:/opt/MCScanX:$PATH
    export MCSCANX_HOME=/opt/MCScanX
    export LC_ALL=C

%runscript
    exec "$@"