Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%post
    export PATH=/opt/conda/bin:$PATH
    export MAMBA_ROOT_PREFIX=/opt/conda

    micromamba install -y -n base -c bioconda -c conda-forge \
        python=3.10 \
        purge_haplotigs=1.1.3 \
        gmap=2024.11.20 \
        busco=5.8.2 \
        seqkit=2.8.2 \
        seqtk \
        minimap2=2.28 \
        samtools=1.21 \
        bedtools=2.31 \
        gffread=0.12.7 \
        bcftools=1.21 \
        diamond=2.1.9 \
        mummer4=4.0.0 \
        mcscanx \
        parallel \
        r-base=4.3 \
        r-tidyverse \
        r-data.table \
        r-optparse \
        pigz \
        wget \
        unzip \
        perl \
        procps-ng

    micromamba clean --all --yes
    rm -rf /opt/conda/pkgs/cache/* 2>/dev/null || true

%environment
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C

%runscript
    exec "$@"