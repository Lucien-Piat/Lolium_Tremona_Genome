Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Purpose popgen_mask_lolium

%post
    export DEBIAN_FRONTEND=noninteractive
    mamba install -y -n base -c conda-forge -c bioconda \
        genmap \
        mosdepth \
        bedtools \
        bcftools \
        samtools \
        htslib \
        datamash
    mamba clean -a -y

%environment
    export LC_ALL=C
    export LANG=C

%runscript
    exec "$@"