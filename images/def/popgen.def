Bootstrap: docker
From: condaforge/miniforge3:latest

%post
    export DEBIAN_FRONTEND=noninteractive
    mamba install -y -n base -c conda-forge -c bioconda \
        genmap \
        mosdepth \
        bedtools \
        bcftools \
        samtools \
        htslib \
        datamash \
        bioconductor-snprelate \
        bioconductor-lea \
        r-tidyverse \
        r-scales \
        r-ggplot2 \
        r-reshape2 \
        r-magrittr
    mamba clean -a -y
    
%environment
    export LC_ALL=C
    export LANG=C

%runscript
    exec "$@"