Bootstrap: docker
From: condaforge/mambaforge:24.3.0-0

%post
    mamba install -y -c bioconda -c conda-forge \
        python=3.11 \
        samtools=1.21 \
        pysam=0.22.1 \
        minimap2=2.28 \
        mashmap=3.1.3 \
        matplotlib-base=3.9 \
        blast=2.16.0 \
        numpy=2.0 \
        seqkit=2.8.2 
    mamba clean -y --all

%environment
    export LC_ALL=C
    export MPLBACKEND=Agg

%runscript
    exec "$@"