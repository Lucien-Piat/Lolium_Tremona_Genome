Bootstrap: docker
From: condaforge/mambaforge:24.3.0-0

%labels
    Author Tremona team
    Version 1.0
    Description Liftoff annotation transfer plus merging utilities

%post
    mamba install -y -c bioconda -c conda-forge \
        liftoff=1.6.3 \
        minimap2=2.28 \
        bedtools=2.31.1 \
        samtools=1.21 \
        seqkit \
        pigz
    mamba clean --all --yes

%environment
    export LC_ALL=C
    export LANG=C

%runscript
    exec "$@"