Bootstrap: docker
From: condaforge/mambaforge:latest

%post
    # Install everything in one go to ensure dependency resolution
    mamba create -n mito_env -y -c bioconda -c conda-forge \
        python=3.9 \
        purge_dups \
        minimap2 \
        samtools \
        seqkit \
        pigz \
        git \
        pandas \
        biopython \
        blast \
        cd-hit \
        dna_features_viewer \
        bcbio-gff

    mamba clean -a -y

    git clone https://github.com/marcelauliano/MitoHiFi.git /opt/MitoHiFi
    
    sed -i '1i #!/opt/conda/envs/mito_env/bin/python' /opt/MitoHiFi/src/mitohifi.py
    chmod +x /opt/MitoHiFi/src/mitohifi.py

%environment
    export PATH="/opt/conda/envs/mito_env/bin:/opt/MitoHiFi/src:$PATH"
    export PYTHONPATH="/opt/MitoHiFi/src:$PYTHONPATH"
    export PYTHONWARNINGS="ignore::SyntaxWarning"
