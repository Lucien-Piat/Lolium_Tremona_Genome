Bootstrap: docker
From: mambaorg/micromamba:1.5.10

%environment
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8

%post
    set -e
    micromamba install -y -n base -c conda-forge -c bioconda \
        minimap2=2.30 \
        samtools=1.21 \
        sambamba=1.0.1 \
        gatk4=4.6.2.0 \
        bcftools=1.21 \
        yq \
        pigz
    micromamba clean -a -y
