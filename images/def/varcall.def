Bootstrap: docker
From: mambaorg/micromamba:1.5.10

%labels
    Description Variant calling toolkit: minimap2, samtools, sambamba, gatk4, bcftools

%environment
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8

%post
    set -e
    micromamba install -y -n base -c conda-forge -c bioconda \
        minimap2=2.30 \
        samtools=1.21 \
        sambamba=1.0.1 \
        gatk4=4.6.2.0 \
        bcftools=1.21 \
        yq \
        pigz
    micromamba clean -a -y

%test
    minimap2 --version
    samtools --version | head -1
    sambamba --version 2>&1 | head -2
    gatk --version
    bcftools --version | head -1
    yq --version