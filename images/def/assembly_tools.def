Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%post
    export MAMBA_ROOT_PREFIX=/opt/conda

    micromamba install -y -n base -c bioconda -c conda-forge \
        python=3.10 \
        ragtag=2.1.0 \
        seqkit=2.8.2 \
        minimap2=2.28 \
        samtools=1.21 \
        pigz

    micromamba clean --all --yes

%environment
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C

%runscript
    exec "$@"