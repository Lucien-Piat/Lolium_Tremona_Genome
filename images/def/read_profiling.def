Bootstrap: docker
From: condaforge/mambaforge:latest
Stage: builder

%post
    mamba create -p /opt/qc -y -c bioconda -c conda-forge \
        python=3.9 \
        meryl \
        genomescope2 \
        pigz \
        samtools \
        seqkit
    mamba clean -a -y

Bootstrap: docker
From: debian:bookworm-slim
Stage: final

%files from builder
    /opt/qc /opt/qc

%environment
    export PATH="/opt/qc/bin:$PATH"
    export LC_ALL=C

%runscript
    exec "$@"
