configfile: "config.yaml"

EXPS     = config["experiments"]
THR      = f"{config['paralies_threshold']:g}"
HETS     = [f"{h:g}" for h in config["het_levels"]]
BASE_HET = HETS[0]
REPS     = [f"{i:02d}" for i in range(config["replicates"])]
FRACS    = [f"{f:g}" for f in config["degrade_fracs"]]
MODES    = config["degrade_modes"]
SIZES    = [f"{m:g}" for m in config["scale_sizes_mb"]]
DENS_MB  = f"{config['scale_density_size_mb']:g}"
DENS     = [f"{round(1.0 - k, 6):g}" for k in config["scale_density_keep"]]
BASE_MB  = f"{config['injection_base_mb']:g}"

wildcard_constraints:
    exp  = "|".join(EXPS),
    rep  = r"\d+",
    het  = r"[0-9.]+",
    frac = r"[0-9.]+",
    drop = r"[0-9.]+",
    mode = r"drop|frag",
    mb   = r"[0-9.]+",

localrules: all, aggregate_blocks, aggregate_bp


rule all:
    input: "results/figure_summary.pdf", "results/figure_bp_errors.pdf"


# --- reference, and the pre-purge that clears its own recent duplications ---
rule fetch_reference_fasta:
    output: temp("results/data/genome_full.fa")
    shell:  "curl -sSL {config[fasta_url]} | gunzip > {output}"


rule fetch_reference_annotation:
    output: temp("results/data/genome_full.gff3")
    shell:  "curl -sSL {config[gff_url]} | gunzip > {output}"


rule extract_target_chromosomes:
    input:
        fa  = "results/data/genome_full.fa",
        gff = "results/data/genome_full.gff3",
    output:
        fa  = "results/data/genome.fa",
        gff = "results/data/genome.gff3",
    params:
        chroms = " ".join(config["chromosome"]
                          if isinstance(config["chromosome"], list)
                          else [config["chromosome"]]),
    container: "dependencies/paralies_bench.sif"
    shell:
        r"""
        set -euo pipefail
        samtools faidx {input.fa}
        : > {output.fa}
        : > {output.gff}
        for C in {params.chroms}; do
            samtools faidx {input.fa} "$C" | sed "1s/.*/>$C/" >> {output.fa}
            awk -v c="$C" 'BEGIN{{FS=OFS="\t"}} !/^#/ && $1==c' \
                {input.gff} >> {output.gff}
        done
        """


rule subset_injection_base:
    input:
        fa  = "results/data/genome.fa",
        gff = "results/data/genome.gff3",
    output:
        fa  = temp("results/data/base_raw.fa"),
        gff = temp("results/data/base_raw.gff3"),
    params: target_mb = BASE_MB
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/make_subset.py"


rule index_base_raw:
    input:  "results/data/base_raw.fa"
    output: temp("results/data/base_raw.fa.fai")
    container: "dependencies/paralies_bench.sif"
    shell:  "samtools faidx {input}"


rule paralies_on_raw_base:
    input:
        fa  = "results/data/base_raw.fa",
        fai = "results/data/base_raw.fa.fai",
        gff = "results/data/base_raw.gff3",
    output:
        bed     = "results/data/prepurge/to_remove.bed",
        synteny = "results/data/prepurge/synteny_ks.tsv",
    params:    threshold = THR
    threads:   4
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/run_paralies.py"


rule prepurge_reference:
    input:
        fa  = "results/data/base_raw.fa",
        gff = "results/data/base_raw.gff3",
        bed = "results/data/prepurge/to_remove.bed",
    output:
        fa  = "results/data/base.fa",
        gff = "results/data/base.gff3",
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/prepurge_reference.py"


rule index_base:
    input:  "results/data/base.fa"
    output: "results/data/base.fa.fai"
    container: "dependencies/paralies_bench.sif"
    shell:  "samtools faidx {input}"


rule paralies_on_clean_base:
    # Verification: the pre-purged assembly must yield nothing. This is also
    # the floor drawn in the base-pair figure.
    input:
        fa  = "results/data/base.fa",
        fai = "results/data/base.fa.fai",
        gff = "results/data/base.gff3",
    output:
        bed     = "results/data/postpurge/to_remove.bed",
        synteny = "results/data/postpurge/synteny_ks.tsv",
    params:    threshold = THR
    threads:   4
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/run_paralies.py"


# --- injection, replicated -------------------------------------------------
# priority + temp() keep the DAG depth-first: breadth-first peaks near 90 GB.
rule inject_experiment:
    priority: 10
    input:
        fa  = "results/data/base.fa",
        gff = "results/data/base.gff3",
    output:
        collapsed     = temp("results/exp/{exp}/rep{rep}/collapsed.fa"),
        collapsed_gff = temp("results/exp/{exp}/rep{rep}/collapsed.gff3"),
        truth         = "results/exp/{exp}/rep{rep}/truth_table.tsv",
    params:
        aks          = lambda w: EXPS[w.exp]["artifact_ks"],
        pks          = lambda w: EXPS[w.exp]["paralogue_ks"],
        gene_counts  = lambda w: EXPS[w.exp]["block_genes"],
        n            = lambda w: EXPS[w.exp]["replicates"],
        omega        = config["omega"],
        indel_ratio  = config["indel_ratio"],
        indel_mean   = config["indel_mean_bp"],
        flank        = config["flank_bp"],
        buffer_genes = config["buffer_genes"],
        seed         = lambda w: config["seed"] + 1000 * int(w.rep),
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/inject.py"


rule index_collapsed:
    priority: 60
    input:  "results/exp/{exp}/rep{rep}/collapsed.fa"
    output: "results/exp/{exp}/rep{rep}/collapsed.fa.fai"
    container: "dependencies/paralies_bench.sif"
    shell:  "samtools faidx {input}"


rule apply_het_to_collapsed:
    priority: 60
    input:
        fa  = "results/exp/ks/rep{rep}/collapsed.fa",
        gff = "results/exp/ks/rep{rep}/collapsed.gff3",
    output: temp("results/exp/ks/rep{rep}/het{het}/collapsed.fa")
    params:
        seed = lambda w: config["seed"] + 1000 * int(w.rep),
        salt = 11,
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/apply_het.py"


rule index_het_collapsed:
    priority: 60
    input:  "results/exp/ks/rep{rep}/het{het}/collapsed.fa"
    output: temp("results/exp/ks/rep{rep}/het{het}/collapsed.fa.fai")
    container: "dependencies/paralies_bench.sif"
    shell:  "samtools faidx {input}"


# --- ParaLies --------------------------------------------------------------
