# --- annotation degradation ------------------------------------------------
rule degrade_annotation:
    priority: 60
    input:  gff = "results/exp/main/rep{rep}/collapsed.gff3"
    output: temp("results/degraded/rep{rep}/gff_{mode}{frac}.gff3")
    params: seed = lambda w: config["seed"] + 1000 * int(w.rep)
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/degrade.py"


rule paralies_degraded:
    priority: 80
    input:
        fa  = "results/exp/main/rep{rep}/collapsed.fa",
        fai = "results/exp/main/rep{rep}/collapsed.fa.fai",
        gff = "results/degraded/rep{rep}/gff_{mode}{frac}.gff3",
    output:
        bed     = "results/degraded/rep{rep}/paralies_{mode}{frac}/to_remove.bed",
        synteny = "results/degraded/rep{rep}/paralies_{mode}{frac}/synteny_ks.tsv",
    params:    threshold = THR
    threads:   1
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/run_paralies.py"


# --- scoring ---------------------------------------------------------------
rule score_het:
    priority: 100
    input:
        truth   = "results/exp/ks/rep{rep}/truth_table.tsv",
        fai     = "results/exp/ks/rep{rep}/collapsed.fa.fai",
        bed     = "results/exp/ks/rep{rep}/het{het}/paralies/to_remove.bed",
        synteny = "results/exp/ks/rep{rep}/het{het}/paralies/synteny_ks.tsv",
    output:
        blocks = "results/score/ks/rep{rep}_het{het}_blocks.tsv",
        bp     = "results/score/ks/rep{rep}_het{het}_bp.tsv",
    params:
        threshold = THR, experiment = "ks",
        rep = lambda w: w.rep, condition = lambda w: w.het,
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/score_run.py"


rule score_plain:
    priority: 100
    input:
        truth   = "results/exp/{exp}/rep{rep}/truth_table.tsv",
        fai     = "results/exp/{exp}/rep{rep}/collapsed.fa.fai",
        bed     = "results/exp/{exp}/rep{rep}/paralies/to_remove.bed",
        synteny = "results/exp/{exp}/rep{rep}/paralies/synteny_ks.tsv",
    output:
        blocks = "results/score/{exp}/rep{rep}_blocks.tsv",
        bp     = "results/score/{exp}/rep{rep}_bp.tsv",
    params:
        threshold = THR, experiment = lambda w: w.exp,
        rep = lambda w: w.rep, condition = "intact",
    wildcard_constraints: exp = "genes|main"
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/score_run.py"


rule score_degraded:
    priority: 100
    input:
        truth   = "results/exp/main/rep{rep}/truth_table.tsv",
        fai     = "results/exp/main/rep{rep}/collapsed.fa.fai",
        bed     = "results/degraded/rep{rep}/paralies_{mode}{frac}/to_remove.bed",
        synteny = "results/degraded/rep{rep}/paralies_{mode}{frac}/synteny_ks.tsv",
    output:
        blocks = "results/score/degrade/rep{rep}_{mode}{frac}_blocks.tsv",
        bp     = "results/score/degrade/rep{rep}_{mode}{frac}_bp.tsv",
    params:
        threshold = THR,
        experiment = lambda w: f"degrade_{w.mode}",
        rep = lambda w: w.rep, condition = lambda w: w.frac,
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/score_run.py"


rule aggregate_blocks:
    input:
        expand("results/score/ks/rep{rep}_het{het}_blocks.tsv", rep=REPS, het=HETS),
        expand("results/score/{exp}/rep{rep}_blocks.tsv", exp=["genes", "main"], rep=REPS),
        expand("results/score/degrade/rep{rep}_{mode}{frac}_blocks.tsv",
               rep=REPS, mode=MODES, frac=FRACS),
    output: "results/blocks_all.tsv"
    script: "scripts/aggregate.py"


rule aggregate_bp:
    input:
        expand("results/score/ks/rep{rep}_het{het}_bp.tsv", rep=REPS, het=HETS),
        expand("results/score/{exp}/rep{rep}_bp.tsv", exp=["genes", "main"], rep=REPS),
        expand("results/score/degrade/rep{rep}_{mode}{frac}_bp.tsv",
               rep=REPS, mode=MODES, frac=FRACS),
    output: "results/bp_all.tsv"
    script: "scripts/aggregate.py"


# --- scaling ladders, on the full assembly, no injection -------------------
rule subset_genome_by_size:
    input:
        fa  = "results/data/genome.fa",
        gff = "results/data/genome.gff3",
    output:
        fa  = "results/scale/size{mb}/genome.fa",
        gff = "results/scale/size{mb}/genome.gff3",
    params: target_mb = lambda w: w.mb
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/make_subset.py"


rule link_density_fasta:
    input:  f"results/scale/size{DENS_MB}/genome.fa"
    output: "results/scale/dens{drop}/genome.fa"
    shell:  "cp {input} {output}"


rule thin_annotation_for_density:
    input:  gff = f"results/scale/size{DENS_MB}/genome.gff3"
    output: "results/scale/dens{drop}/genome.gff3"
    params: seed = config["seed"]
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/thin_annotation.py"


rule index_scale_genome:
    input:  "results/scale/{point}/genome.fa"
    output: "results/scale/{point}/genome.fa.fai"
    wildcard_constraints: point = r"(size|dens)[0-9.]+"
    container: "dependencies/paralies_bench.sif"
    shell:  "samtools faidx {input}"


rule paralies_scaling_point:
    # The benchmark file IS the measurement behind panels (e) and (f).
    input:
        fa  = "results/scale/{point}/genome.fa",
        fai = "results/scale/{point}/genome.fa.fai",
        gff = "results/scale/{point}/genome.gff3",
    output:
        bed     = "results/scale/{point}/paralies/to_remove.bed",
        synteny = "results/scale/{point}/paralies/synteny_ks.tsv",
    params:    threshold = THR
    wildcard_constraints: point = r"(size|dens)[0-9.]+"
    threads:   4
    benchmark: "results/benchmarks/paralies_scale_{point}.txt"
    container: "dependencies/paralies_bench.sif"
    script:    "scripts/run_paralies.py"


rule collect_scaling:
    input:
        bench  = expand("results/benchmarks/paralies_scale_size{mb}.txt", mb=SIZES),
        gff    = expand("results/scale/size{mb}/genome.gff3", mb=SIZES),
        fai    = expand("results/scale/size{mb}/genome.fa.fai", mb=SIZES),
        bed    = expand("results/scale/size{mb}/paralies/to_remove.bed", mb=SIZES),
        dbench = expand("results/benchmarks/paralies_scale_dens{d}.txt", d=DENS),
        dgff   = expand("results/scale/dens{d}/genome.gff3", d=DENS),
        dfai   = expand("results/scale/dens{d}/genome.fa.fai", d=DENS),
        dbed   = expand("results/scale/dens{d}/paralies/to_remove.bed", d=DENS),
    output: "results/scaling.tsv"
    container: "dependencies/paralies_bench.sif"
    script: "scripts/collect_scaling.py"


